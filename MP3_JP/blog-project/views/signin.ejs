<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in | Everyday Notes</title><link rel="stylesheet" href="/style.css"></head><body><header class="topbar"><a class="brand" href="/">Everyday<span>Notes</span></a><nav><a href="/">Home</a><a class="nav-cta" href="/signup">Create account</a></nav></header><main class="auth-wrap"><a class="back-link" href="/">← Back to blog</a><section class="auth-card"><div class="auth-icon">✳</div><p class="eyebrow">WELCOME BACK</p><h1>Good to see you.</h1><p class="muted">Sign in to continue to your corner of the community.</p><% if(notice){ %><div class="notice"><%= notice %></div><% } %><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/signin" class="post-form"><label for="user_id">User ID</label><input id="user_id" name="user_id" autocomplete="username" value="<%= values.user_id||'' %>" required><label for="password">Password</label><input id="password" type="password" name="password" autocomplete="current-password" required><button class="button full" type="submit">Sign in <span>↗</span></button></form><p class="auth-switch">New around here? <a href="/signup">Create an account</a></p></section></main></body></html>
