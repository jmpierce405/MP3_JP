<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account | Everyday Notes</title><link rel="stylesheet" href="/style.css"></head><body><header class="topbar"><a class="brand" href="/">Everyday<span>Notes</span></a><nav><a href="/">Home</a><a href="/signin">Sign in</a></nav></header><main class="auth-wrap"><a class="back-link" href="/">← Back to blog</a><section class="auth-card"><div class="auth-icon">✳</div><p class="eyebrow">JOIN THE COMMUNITY</p><h1>Your story starts here.</h1><p class="muted">Create an account to publish and manage your posts.</p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/signup" class="post-form"><label for="name">Display name</label><input id="name" name="name" maxlength="255" autocomplete="name" value="<%= values.name||'' %>" required><label for="user_id">Choose a user ID</label><input id="user_id" name="user_id" maxlength="255" autocomplete="username" value="<%= values.user_id||'' %>" required><label for="password">Password</label><input id="password" type="password" name="password" minlength="6" autocomplete="new-password" required><small class="field-help">Use at least 6 characters.</small><button class="button full" type="submit">Create account <span>↗</span></button></form><p class="auth-switch">Already have an account? <a href="/signin">Sign in</a></p></section></main></body></html>
