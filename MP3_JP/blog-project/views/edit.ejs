<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Edit post | Everyday Notes</title><link rel="stylesheet" href="/style.css"></head><body><header class="topbar"><a class="brand" href="/">Everyday<span>Notes</span></a><nav><a href="/">Home</a><span class="welcome">Hi, <%= user.name %></span></nav></header><main class="auth-wrap edit-wrap"><a class="back-link" href="/">← Back to blog</a><section class="auth-card edit-card"><p class="eyebrow">MAKE IT YOUR BEST</p><h1>Edit your post.</h1><p class="muted">Update your title or make changes to your story.</p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/blogs/<%= post.blog_id %>/edit" class="post-form"><label for="title">Title</label><input id="title" name="title" maxlength="255" value="<%= post.title %>" required><label for="body">Your post</label><textarea id="body" name="body" rows="9" required><%= post.body %></textarea><button class="button full" type="submit">Save changes <span>↗</span></button><a class="cancel-link" href="/">Cancel and return</a></form></section></main></body></html>
