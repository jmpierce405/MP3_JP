<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Everyday Notes | Blog</title><link rel="stylesheet" href="/style.css"></head><body><header class="topbar"><a class="brand" href="/">Everyday<span>Notes</span></a><nav><a href="/">Home</a><% if(user){ %><span class="welcome">Hi, <%= user.name %></span><form action="/signout" method="post" class="inline"><button class="nav-button" type="submit">Sign out</button></form><% }else{ %><a href="/signin">Sign in</a><a class="nav-cta" href="/signup">Create account</a><% } %></nav></header><main class="container"><section class="hero"><p class="eyebrow">A LITTLE SPACE FOR BIG IDEAS</p><h1>Stories worth <em>sharing.</em></h1><p class="subhead">Notes on learning, everyday life, and the things that inspire us.</p></section><% if(notice){ %><div class="notice"><%= notice %></div><% } %><% if(user){ %><section class="panel compose"><div><p class="eyebrow">YOUR NEXT STORY</p><h2>Write a post</h2><p class="muted">Share something you have learned or something on your mind.</p></div><form action="/blogs" method="post" class="post-form"><label for="title">Title</label><input id="title" name="title" maxlength="255" placeholder="Give your post a title" required><label for="body">Your post</label><textarea id="body" name="body" rows="4" placeholder="Start writing here..." required></textarea><button class="button" type="submit">Publish post <span>↗</span></button></form></section><% }else{ %><section class="signin-prompt"><div><strong>Have a story to share?</strong><p>Sign in to publish, edit, and manage your own posts.</p></div><a class="button" href="/signin">Sign in to write ↗</a></section><% } %><section class="feed-heading"><div><p class="eyebrow">THE LATEST</p><h2>From the community</h2></div><span class="post-count"><%= posts.length %> posts</span></section><% if(posts.length===0){ %><div class="empty">No posts yet. Be the first to share a story.</div><% } %><div class="post-grid"><% posts.forEach((post,index)=>{ %><article class="post-card"><div class="card-top"><span class="post-number"><%= String(index+1).padStart(2,'0') %></span><span class="post-date"><%= new Date(post.date_created).toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'}) %></span></div><h3><%= post.title %></h3><p class="post-body"><%= post.body %></p><div class="card-footer"><div class="avatar"><%= (post.creator_name||'?').charAt(0).toUpperCase() %></div><div class="author"><strong><%= post.creator_name %></strong><span>@<%= post.creator_user_id %></span></div><% if(user && user.user_id===post.creator_user_id){ %><div class="post-actions"><a href="/blogs/<%= post.blog_id %>/edit" class="edit-link">Edit</a><form action="/blogs/<%= post.blog_id %>/delete" method="post" onsubmit="return confirm('Permanently delete this post?')"><button type="submit" class="delete-link">Delete</button></form></div><% } %></div></article><% }) %></div></main><footer>Made for sharing ideas, one post at a time.</footer></body></html>
